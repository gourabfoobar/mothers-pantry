PORT=4200
JWT_SECRET=dev-secret-change-me
KIRANA_MCP_URL=http://localhost:4100/mcp
SMS_PROVIDER=console
NODE_ENV=development

# Swiggy Instamart (default provider) — https://mcp.swiggy.com/builders/docs/reference/instamart
# Staging needs no credentials (RFC 7591 dynamic client registration); switch
# SWIGGY_MCP_ORIGIN to https://mcp.swiggy.com once you have production access.
SWIGGY_MCP_ORIGIN=https://mcp-staging.swiggy.com
SWIGGY_REDIRECT_URI=http://localhost:4200/providers/swiggy/callback
PANTRY_DEFAULT_PROVIDER=swiggy

# Milestone 3+
ANTHROPIC_API_KEY=
# Milestone 4+
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=com.motherspantry.app
ORDER_POLL_INTERVAL_MS=5000
